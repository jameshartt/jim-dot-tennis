# Copy to scripts/.deploy.env (untracked) and fill in your own values.
# SSH target for your server, e.g. deploy@your-server.example.com
SERVER=user@your-server.example.com
# Path to the SSH private key used to reach it
SSH_KEY=$HOME/.ssh/your_deploy_key
# Directory on the server where the app is deployed
REMOTE_PATH=/path/to/jim-dot-tennis
