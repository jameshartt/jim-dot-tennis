# Environment for the reference deployment (deploy/docker-compose.yml).
#
#   cp .env.example .env   # in this directory, then edit .env
#
# Compose reads deploy/.env automatically. Never commit .env. Every value below
# is a PLACEHOLDER: replace each "change-me" yourself and keep real values
# private. Generate secrets with e.g.  openssl rand -hex 32
# Nothing in this stack ships with a default password or key, and the app sends
# nothing to the software's author: see docs/outbound_connections.md.

# ---------------------------------------------------------------------------
# Stack (read by docker-compose.yml / Caddy)
# ---------------------------------------------------------------------------

# REQUIRED. Public hostname Caddy serves and gets a TLS certificate for.
# DNS must already point at this host; ports 80 and 443 must be open.
DOMAIN=tennis.example.org

# Version of the jim-dot-tennis image to run, without a leading "v" (see
# CHANGELOG.md and https://github.com/jameshartt/jim-dot-tennis/releases).
# Optional: empty means the version this file shipped with. Change it
# deliberately, after reading that version's upgrade notes.
JIM_DOT_TENNIS_VERSION=0.1.0

# REQUIRED. Password for CourtHive's Postgres database (shared by the postgres
# and courthive-server services). Generate: openssl rand -hex 24
COURTHIVE_PG_PASSWORD=change-me

# REQUIRED. Secret used to sign CourtHive login tokens (JWTs).
# Generate: openssl rand -hex 32
COURTHIVE_JWT_SECRET=change-me

# ---------------------------------------------------------------------------
# jim-dot-tennis app (read by the Go application)
# ---------------------------------------------------------------------------

# Optional overrides for the home club. The home club is resolved from
# HOME_CLUB_ID, then HOME_CLUB_NAME, then the club stored by first-run setup.
# With none of them the app starts in setup mode and sends every page to /setup.
# HOME_CLUB_ID (database id of your club) takes precedence.
HOME_CLUB_ID=
# Fallback: club name for fuzzy lookup, used only when HOME_CLUB_ID is empty.
HOME_CLUB_NAME=

# Optional. Code that unlocks the "club wrapped" pages. Leave it empty: the app
# generates a code for this instance on first start, and administrators can see
# it on the Club Settings page. Set it only to use a code of your own (it then
# wins over the generated one). The app refuses to start in production with a
# placeholder value such as "change-me".
WRAPPED_ACCESS_PASSWORD=

# Optional. Your club's code on the BHPLTA website, for match card imports.
# Normally set on the admin Club Settings page; a value here wins over it.
BHPLTA_CLUB_CODE=

# Optional. URL path of a club logo you serve yourself (e.g. from Caddy; files
# mounted into /app/static are not served: static files are built into the app).
# Normally the logo is uploaded on the Club Settings page; a value here wins.
HOME_CLUB_LOGO_PATH=

# Optional. Override the page the public fixture generator reads league tables
# from. Empty means the BHPLTA league tables page.
LEAGUE_TABLES_URL=

# Testing only. Site root the setup/season import reads the BHPLTA fixtures
# and club pages from. Empty means https://www.bhplta.co.uk. Leave it empty.
BHPLTA_BASE_URL=

# Optional. true/1 shows the "My Tennis" call-to-action. Empty means off.
MY_TENNIS_ENABLED=

# REQUIRED. The instance's public address, https only, normally https://$DOMAIN.
# The app refuses to start in production without a valid https public URL.
# It is used for links sent to players, passkeys and calendar-file UIDs: do not
# change its host later without reading the iCal note in README.md.
PUBLIC_URL=https://tennis.example.org

# Optional. Backups (made by the app itself: a daily one, one before every
# upgrade, and on demand; docs/PRODUCTION_QUICK_REFERENCE.md section 9).
# They hold personal data and password hashes. Copy them off the server too.
# How often: a duration such as 24h or 6h (at least 15m), or off. Empty means 24h.
BACKUP_INTERVAL=
# How many daily/manual backups to keep. Empty means 14.
BACKUP_KEEP=
# Where they are kept. Empty means /app/data/backups (on the data volume).
BACKUP_DIR=

# ---------------------------------------------------------------------------
# Read by the app but NOT passed through by deploy/docker-compose.yml
# (set in the compose file's app environment if you really need them)
# ---------------------------------------------------------------------------
# APP_ENV            Compose fixes this to "production" (Secure session cookies).
# DEV_MODE           true makes session cookies non-Secure for plain-http local runs.
#                    The app refuses to start with it when APP_ENV=production. Never set it in production.
# PORT               Compose fixes this to 8080.
# DB_TYPE            Only "sqlite3" is supported; compose sets it.
# DB_PATH            Compose sets /app/data/tennis.db (the tennis-data volume).
# COURTHIVE_API_URL  Defaults to http://courthive-server:8383, correct for this stack.
# TEMPLATE_RELOAD    true reads templates/ and static/ from disk (instead of the copies
#                    built into the binary) and re-parses templates on every request.
#                    Development only; leave unset in production (the root
#                    docker-compose.yml sets it for local dev and mounts the directories).
