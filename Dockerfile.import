FROM golang:1.27-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

# Set working directory
WORKDIR /app

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies (module cache persists across builds via BuildKit cache mount)
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Copy source code
COPY . .

# Build all the import binaries (pure Go, no C toolchain needed)
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -o /app/bin/import-matchcards ./cmd/import-matchcards \
    && CGO_ENABLED=0 GOOS=linux go build -o /app/bin/import-tennis-players ./cmd/import-tennis-players

# Final stage - lightweight image with pre-built binaries (pinned Alpine)
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

# Install runtime dependencies
RUN apk add --no-cache bash ca-certificates

# Copy binaries from builder
COPY --from=builder /app/bin/ /usr/local/bin/

# Set working directory
WORKDIR /app

# Default command
CMD ["bash"] 